<Project Sdk="Snail.Sdk.Mcp">

    <!--
        Native, as Snail.MCP.CleanUp: a platform tool per system, a portable one for the rest (Snail.Sdk.Mcp,
        SnailMcpNative at its default). Stdio for a program started by one caller, HTTP for the server standing behind
        every agent of a machine. The container is native too: its Dockerfile publishes for the platform of the image.
    -->
    <PropertyGroup>
        <SnailMcpTransport>Both</SnailMcpTransport>
        <SnailMcpContainer>true</SnailMcpContainer>
    </PropertyGroup>

    <PropertyGroup>
        <!-- The links-free opening of LinklessDisk is called through LibraryImport, whose generated marshalling is unsafe code. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <PropertyGroup>
        <Version>0.1.0</Version>
        <Description>Local MCP server that lets AI agents read, write and search the files of the working copy a session names, and nothing outside it.</Description>
        <PackageTags>mcp;mcp-server;modelcontextprotocol;ai;claude;filesystem;dotnet-tool</PackageTags>
        <PackageProjectUrl>https://github.com/orldev/Snail.MCP.FileSystem</PackageProjectUrl>
        <RepositoryUrl>https://github.com/orldev/Snail.MCP.FileSystem</RepositoryUrl>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="ModelContextProtocol"/>
        <PackageReference Include="ModelContextProtocol.AspNetCore"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Snail.MCP.FileSystem.Tests"/>
    </ItemGroup>

</Project>

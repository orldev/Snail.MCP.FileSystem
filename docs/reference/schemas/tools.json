  {
    "name": "edit_file",
    "description": "Replaces exact text in a file; nothing else in it changes, its encoding and line ends included. Refuses when the text is not there, when it is there more than once without \u0027all\u0027, and when the file is too large to read whole: write such a file with write_file.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "description": "Path of the file, absolute or relative to the session\u0027s root.",
          "type": "string"
        },
        "find": {
          "description": "The exact text to replace, with its indentation; a line end may be written as \\n.",
          "type": "string"
        },
        "replace": {
          "description": "What to put in its place; empty removes it.",
          "type": "string"
        },
        "all": {
          "description": "Replace every occurrence rather than refusing when there is more than one.",
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "path",
        "find",
        "replace"
      ]
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "ok": {
          "description": "true: the call did what was asked. A refusal comes as an error result with ok false, error and hint.",
          "type": "boolean"
        },
        "data": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "path": {
              "description": "The file, relative to the session\u0027s root.",
              "type": "string"
            },
            "replaced": {
              "description": "How many places were replaced.",
              "type": "integer"
            },
            "bytes": {
              "description": "The length of the file now, in bytes.",
              "type": "integer"
            }
          },
          "required": [
            "path",
            "replaced",
            "bytes"
          ]
        },
        "error": {
          "description": "Always null here: a refusal is an error result.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "hint": {
          "description": "Always null here: a refusal is an error result.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "required": [
        "ok",
        "data"
      ]
    },
    "annotations": {
      "destructiveHint": true,
      "openWorldHint": false
    },
    "skill": null
  },
  {
    "name": "list_directory",
    "description": "Lists what is under a folder, to the depth asked for. Build output, .git and links are never walked into.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "description": "Folder to work in; omit for the session\u0027s root.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "depth": {
          "description": "How many folders deep to go; two by default, eight at most.",
          "type": "integer",
          "default": 2
        }
      }
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "ok": {
          "description": "true: the call did what was asked. A refusal comes as an error result with ok false, error and hint.",
          "type": "boolean"
        },
        "data": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "path": {
              "description": "The folder listed, relative to the session\u0027s root.",
              "type": "string"
            },
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "description": "Relative to the session\u0027s root.",
                    "type": "string"
                  },
                  "isDirectory": {
                    "description": "Whether it is a folder.",
                    "type": "boolean"
                  },
                  "bytes": {
                    "description": "The length of a file in bytes; 0 for a folder.",
                    "type": "integer"
                  }
                },
                "required": [
                  "path",
                  "isDirectory",
                  "bytes"
                ]
              }
            },
            "isCut": {
              "description": "Whether there was more than the server lists at once.",
              "type": "boolean"
            },
            "unread": {
              "description": "Folders that could not be opened, so nothing in them is listed.",

[
  {
    "name": "read_file",
    "description": "Reads a file as text, whole or by lines. Says how many lines it has and whether the answer was cut. A file too large to read whole is read by lines.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "description": "Path of the file, absolute or relative to the session\u0027s root.",
          "type": "string"
        },
        "from": {
          "description": "First line to return, counting from one; omit for the start of the file.",
          "type": [
            "integer",
            "null"
          ],
          "default": null
        },
        "to": {
          "description": "Last line to return; omit for the end of the file.",
          "type": [
            "integer",
            "null"
          ],
          "default": null
        }
      },
      "required": [
        "path"
      ]
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "ok": {
          "description": "true: the call did what was asked. A refusal is an error result with ok false, error, hint and type in its text alone.",
          "type": "boolean"
        },
        "error": {
          "description": "Why the call did not go through; present only on a refusal, which is an error result.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "hint": {
          "description": "What to do about a refusal; present only on one.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "type": {
          "description": "The kind of refusal, a word a program can branch on; present only on one.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "data": {
          "description": "What the tool answers.",
          "type": "object",
          "properties": {
            "path": {
              "description": "The file, relative to the session\u0027s root.",
              "type": "string"
            },
            "from": {
              "description": "The first line given, counted from 1.",
              "type": "integer"
            },
            "to": {
              "description": "The last line given.",
              "type": "integer"
            },
            "lines": {
              "description": "How many lines the file has.",
              "type": "integer"
            },
            "text": {
              "description": "The lines from..to, joined by line ends.",
              "type": "string"
            },
            "isCut": {
              "description": "Whether the text was cut at the server\u0027s output limit; read on from the line after the last one shown.",
              "type": "boolean"
            }
          },
          "required": [
            "path",
            "from",
            "to",
            "lines",
            "text",
            "isCut"
          ]
        }
      },
      "required": [
        "ok",
        "data"
      ]
    },
    "annotations": {
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "skill": null
  },

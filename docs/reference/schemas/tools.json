        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "parameters": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "type": {
                      "description": "The JSON type of the value.",
                      "type": "string"
                    },
                    "isRequired": {
                      "description": "Whether the call must give it.",
                      "type": "boolean"
                    },
                    "description": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "name",
                    "type",
                    "isRequired",
                    "description"
                  ]
                }
              }
            },
            "required": [
              "name",
              "description",
              "parameters"
            ]
          }
        }
      },
      "required": [
        "task",
        "isMatched",
        "note",
        "tools"
      ]

  {
    "name": "find_tool",
    "description": "Names the tools that answer a task described in words, with the parameters each takes.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "task": {
          "description": "What you are trying to do, in words: \u0027change one line\u0027, \u0027where is this text\u0027.",
          "type": "string"
        },
        "limit": {
          "description": "How many tools to name; five by default.",
          "type": "integer",
          "default": 5
        }
      },
      "required": [
        "task"
      ]
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "task": {
          "description": "The task as asked.",
          "type": [
            "string",
            "null"
          ]
        },
        "isMatched": {
          "description": "Whether any tool matched; when none did, every tool is listed.",
          "type": "boolean"

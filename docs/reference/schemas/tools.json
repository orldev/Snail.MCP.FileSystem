  {
    "name": "edit_file",
    "description": "Replaces exact text in a file; nothing else in it changes, its encoding and line ends included. Refuses when the text is not there, when it is there more than once without \u0027all\u0027, and when the file is too large to read whole: write such a file with write_file.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "description": "Path of the file, absolute or relative to the session\u0027s root.",
          "type": "string"
        },
        "find": {
          "description": "The exact text to replace, with its indentation; a line end may be written as \\n.",
          "type": "string"
        },
        "replace": {
          "description": "What to put in its place; empty removes it.",
          "type": "string"
        },
        "all": {
          "description": "Replace every occurrence rather than refusing when there is more than one.",
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "path",
        "find",
        "replace"
      ]
    },
    "outputSchema": {
